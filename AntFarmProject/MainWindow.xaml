<Window x:Class="AntFarmProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🐜 Ant Farm Simulator" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgDark}">

    <Window.Resources>
        <!-- ТЕМНА ТЕМА (за замовчуванням) -->
        <SolidColorBrush x:Key="BgDark" Color="#0f1419"/>
        <SolidColorBrush x:Key="BgPanel" Color="#1a1f2e"/>
        <SolidColorBrush x:Key="BgCard" Color="#252b3d"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3a4155"/>
        <SolidColorBrush x:Key="TextMain" Color="#e0e6ed"/>
        <SolidColorBrush x:Key="TextSub" Color="#8b95a5"/>
        <SolidColorBrush x:Key="Accent" Color="#00d4aa"/>
        <SolidColorBrush x:Key="Danger" Color="#ff4757"/>
        <SolidColorBrush x:Key="Warning" Color="#ffa502"/>
        <SolidColorBrush x:Key="Info" Color="#3742fa"/>

        <!-- СВІТЛА ТЕМА -->
        <SolidColorBrush x:Key="BgDarkLight" Color="#f5f6fa"/>
        <SolidColorBrush x:Key="BgPanelLight" Color="#ffffff"/>
        <SolidColorBrush x:Key="BgCardLight" Color="#ffffff"/>
        <SolidColorBrush x:Key="BorderColorLight" Color="#dcdde1"/>
        <SolidColorBrush x:Key="TextMainLight" Color="#2f3640"/>
        <SolidColorBrush x:Key="TextSubLight" Color="#718093"/>
        <SolidColorBrush x:Key="AccentLight" Color="#00b894"/>
        <SolidColorBrush x:Key="DangerLight" Color="#e84118"/>
        <SolidColorBrush x:Key="WarningLight" Color="#e1b12c"/>
        <SolidColorBrush x:Key="InfoLight" Color="#273c75"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2d3548"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00b894"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="StatText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="15,8">
            <DockPanel>
                <TextBlock Text="🐜 ANT FARM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <Menu Background="Transparent" Foreground="{DynamicResource TextMain}" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center">
                    <MenuItem Header="🎮 Гра">
                        <MenuItem Header="💾 Зберегти" Click="MenuSave_Click"/>
                        <MenuItem Header="📂 Завантажити" Click="MenuLoad_Click"/>
                        <MenuItem Header="🔄 Нова гра" Click="MenuNewSave_Click"/>
                        <Separator/>
                        <MenuItem Header="❌ Вихід" Click="MenuExit_Click"/>
                    </MenuItem>
                    <MenuItem Header="📊 Статистика" Click="MenuStatistics_Click"/>
                    <MenuItem Header="🔬 Дослідження" Click="MenuResearch_Click"/>
                    <MenuItem Header="🐜 Мурахи" Click="MenuAnts_Click"/>
                    <MenuItem Header="🧱 Перешкоди" Click="MenuObstacles_Click"/>
                    <MenuItem Header="❓ Довідка" Click="MenuHelp_Click"/>
                </Menu>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ThemeBtn" Content="🌙" Click="ThemeToggleButton_Click" Style="{StaticResource Btn}" Width="40" Height="40" Padding="0" Margin="0,0,8,0" FontSize="18"/>
                    <Button x:Name="PauseBtn" Content="⏸" Click="PauseBtn_Click" Style="{StaticResource BtnAccent}" Width="50" Height="40" Padding="0" FontSize="20"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Ресурси -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="8,12,8,4">
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="🍂 ЇЖА" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="FoodText" Text="0" Style="{StaticResource StatText}" Foreground="#00d4aa"/>
                    <TextBlock x:Name="FoodRateText" Text="+0/с" FontSize="11" Foreground="#55efc4" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="🪵 ДЕРЕВИНА" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="WoodText" Text="0" Style="{StaticResource StatText}" Foreground="#ff7675"/>
                    <TextBlock x:Name="WoodRateText" Text="+0/с" FontSize="11" Foreground="#fab1a0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="🪨 КАМІНЬ" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="StoneText" Text="0" Style="{StaticResource StatText}" Foreground="#b2bec3"/>
                    <TextBlock x:Name="StoneRateText" Text="+0/с" FontSize="11" Foreground="#dfe6e9" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="💧 ВОДА" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="WaterText" Text="0" Style="{StaticResource StatText}" Foreground="#74b9ff"/>
                    <TextBlock x:Name="WaterRateText" Text="+0/с" FontSize="11" Foreground="#74b9ff" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="🐜 МУРАХИ" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="AntsText" Text="0/10" Style="{StaticResource StatText}" Foreground="#a29bfe"/>
                    <TextBlock x:Name="AntsWorkingText" Text="0 працюють" FontSize="11" Foreground="#a29bfe" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="👑 РІВЕНЬ" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="LevelText" Text="1" Style="{StaticResource StatText}" Foreground="#fdcb6e"/>
                    <ProgressBar x:Name="LevelProgress" Value="0" Maximum="100" Height="4" Background="{DynamicResource BorderColor}" Foreground="#fdcb6e" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="📅 ЧАС" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="DayText" Text="День 1" Style="{StaticResource StatText}" FontSize="16"/>
                    <TextBlock x:Name="TimeText" Text="08:00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Основна зона -->
        <Grid Grid.Row="2" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Ліва панель -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="⚡ КЕРУВАННЯ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,16"/>

                        <Button x:Name="SpawnAntBtn" Style="{StaticResource BtnAccent}" Click="SpawnAntBtn_Click" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🐜" FontSize="22" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="НОВА МУРАХА" FontWeight="Bold"/>
                                    <TextBlock Text="10 їжі + 5 води" FontSize="10" Foreground="{DynamicResource TextSub}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ExpandNestBtn" Style="{StaticResource Btn}" Click="ExpandNestBtn_Click" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏗️" FontSize="22" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="РОЗШИРИТИ ГНІЗДО" FontWeight="Bold"/>
                                    <TextBlock Text="50 дер. + 25 кам." FontSize="10" Foreground="{DynamicResource TextSub}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{DynamicResource BorderColor}" Margin="0,0,0,16"/>

                        <Button Style="{StaticResource Btn}" Click="GatherFoodBtn_Click" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍂" Margin="0,0,8,0"/>
                                <TextBlock Text="ЗБИРАТИ ЇЖУ" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Click="GatherWoodBtn_Click" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪵" Margin="0,0,8,0"/>
                                <TextBlock Text="РУБАТИ ДЕРЕВО" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Click="GatherStoneBtn_Click" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪨" Margin="0,0,8,0"/>
                                <TextBlock Text="ДОБУВАТИ КАМІНЬ" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Click="GatherWaterBtn_Click" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💧" Margin="0,0,8,0"/>
                                <TextBlock Text="ЗБИРАТИ ВОДУ" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{DynamicResource BorderColor}" Margin="0,0,0,16"/>

                        <Button Style="{StaticResource BtnDanger}" Click="KillAntBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💀" Margin="0,0,8,0"/>
                                <TextBlock Text="ВБИТИ МУРАХУ" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SpeedBtn" Content="▶ x1" Style="{StaticResource Btn}" Click="SpeedBtn_Click" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Ігрове поле -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Background="#0d1117" Padding="0">
                <Grid>
                    <Border Background="{DynamicResource BgDark}" CornerRadius="16" Margin="12">
                        <Canvas x:Name="GameCanvas" ClipToBounds="True" MouseLeftButtonDown="GameCanvas_PlaceObstacle">
                            <Grid x:Name="NestGrid" Canvas.Left="350" Canvas.Top="200">
                                <Ellipse Width="150" Height="150" Fill="{DynamicResource BgCard}" Stroke="#fdcb6e" StrokeThickness="3">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#fdcb6e" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="🏰" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0"/>
                                <Border Background="#fdcb6e" CornerRadius="10" Padding="8,3" VerticalAlignment="Bottom" Margin="0,0,0,15">
                                    <TextBlock x:Name="NestLevelText" Text="РІВЕНЬ 1" Foreground="#2d3436" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Border>
                    <Border Background="{DynamicResource BgCard}" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,24,0,0" Opacity="0.9">
                        <TextBlock x:Name="CoordsText" Text="📍 X:0 | Y:0" Foreground="{DynamicResource TextSub}" FontFamily="Consolas" FontSize="12"/>
                    </Border>
                    <Border x:Name="WeatherBadge" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0" Opacity="0.9">
                        <TextBlock x:Name="WeatherText" Text="☀️ Сонячно" Foreground="#fdcb6e" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Права панель -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="📊 СТАТИСТИКА" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="TotalFoodText" Text="🍂 0" Foreground="#00d4aa" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TotalWoodText" Text="🪵 0" Foreground="#ff7675" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TotalStoneText" Text="🪨 0" Foreground="#b2bec3" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TotalWaterText" Text="💧 0" Foreground="#74b9ff" FontSize="13"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="AntsBornText" Text="🐣 0" Foreground="#a29bfe" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="AntsDiedText" Text="💀 0" Foreground="#ff7675" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="NestExpansionsText" Text="🏗️ 0" Foreground="#fdcb6e" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DaysSurvivedText" Text="📅 1 день" Foreground="{DynamicResource TextSub}" FontSize="13"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📋 ЖУРНАЛ ПОДІЙ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EventLog"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Статус бар -->
        <Border Grid.Row="3" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="✅ Гра активна" Foreground="{DynamicResource Accent}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="💾 Швидке збереження" Style="{StaticResource Btn}" Click="QuickSaveBtn_Click" Padding="12,6" Margin="0,0,10,0" FontSize="11"/>
                    <TextBlock Text="v3.0" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Сповіщення -->
        <Border x:Name="NotificationPanel" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="100" 
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" 
                CornerRadius="16" Padding="24,16" Visibility="Collapsed" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NotificationIcon" Text="✅" FontSize="32" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                <TextBlock x:Name="NotificationText" Text="" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>